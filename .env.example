# OpportunityX-AI: Supabase PostgreSQL Configuration
# Copy this file to .env.local and replace with your actual Supabase project credentials.
#
# Obtain these from: https://app.supabase.com -> Project Settings -> API

# Public API URL (accessible by browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key (safe for browser client with Row Level Security enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-token-here

# Server-side Service Role Key (NEVER expose to frontend code or commit to source control)
# Only required for admin operations or batch database syncing
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
